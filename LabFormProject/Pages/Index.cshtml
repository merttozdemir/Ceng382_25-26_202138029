@page
@model LabFormProject.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!-- I took lots of the parts from Chatgpt. -->
<div class="container mt-4">
    <div class="row">
        <!-- Form on the left -->
        <div class="col-md-4 mb-4">
            <h2>Add Class</h2>
            <form method="post" asp-page-handler="Add">
                <div class="mb-3">
                    <label asp-for="ClassInfo.ClassName" class="form-label">Class Name</label>
                    <input asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInfo.StudentCount" class="form-label">Student Count</label>
                    <input asp-for="ClassInfo.StudentCount" class="form-control" type="number" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassInfo.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="ClassInfo.IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="ClassInfo.IsActive" class="form-check-label">Is Active</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Add Class</button>
            </form>
        </div>

        <!-- Table on the right -->
        <div class="col-md-8">
            <h2>Class List</h2>

            <!-- Filter Form -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control" placeholder="Filter by Class Name" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="PageNumber" value="1" />
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                </div>
            </form>

            <!-- Table -->
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Is Active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredTableData)
                    {
                        <tr>
                            <td>@item.ID</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>@(item.IsActive ? "Yes" : "No")</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="ID" value="@item.ID" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination Links -->
            <div class="mt-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)&PageSize=@Model.PageSize&FilterClassName=@Model.FilterClassName">Previous</a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="?PageNumber=@i&PageSize=@Model.PageSize&FilterClassName=@Model.FilterClassName">@i</a>
                            </li>
                        }

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)&PageSize=@Model.PageSize&FilterClassName=@Model.FilterClassName">Next</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>

            <h4>Export Options</h4>
            <form method="post" asp-page-handler="ExportJson">
                <div class="mb-2">
                    <label>Select columns to export:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="ClassName" id="colClassName" />
                        <label class="form-check-label" for="colClassName">Class Name</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="StudentCount" id="colStudentCount" />
                        <label class="form-check-label" for="colStudentCount">Student Count</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="Description" id="colDescription" />
                        <label class="form-check-label" for="colDescription">Description</label>
                    </div>
                </div>

                <input type="hidden" name="FilterClassName" value="@Model.FilterClassName" />
                <button type="submit" class="btn btn-success me-2" name="mode" value="filtered">Export Filtered to JSON</button>
                <button type="submit" class="btn btn-info" name="mode" value="all">Export All to JSON</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
